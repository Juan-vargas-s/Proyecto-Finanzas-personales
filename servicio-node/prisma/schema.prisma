generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_AUTH")
}

model Usuario {
  id              String   @id @default(uuid())
  nombre          String
  email           String   @unique
  passwordHash    String
  monedaPreferida String   @default("MXN")
  createdAt       DateTime @default(now())
}
