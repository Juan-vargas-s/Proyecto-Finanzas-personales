# PostgreSQL
DB_USER=finanzas
DB_PASSWORD=cambia_esta_password
DB_NAME_AUTH=auth_db
DB_NAME_FINANZAS=finanzas_db
DATABASE_URL_AUTH=postgresql://finanzas:cambia_esta_password@postgres:5432/auth_db
# Puerto del host para conectar pgAdmin/psql al PostgreSQL del contenedor.
# Solo afecta el acceso desde tu maquina; los servicios siguen usando postgres:5432.
# Si ya tienes un PostgreSQL local en 5432, cambia a 5433 (o el que tengas libre).
POSTGRES_HOST_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# Autenticación
JWT_SECRET=cambia_esta_clave_secreta

# Comunicación entre microservicios
JAVA_SERVICE_URL=http://servicio-java:8080

# Next.js
NEXT_PUBLIC_API_GATEWAY=http://localhost

# SMTP (OBLIGATORIO — sin esto el registro de cuentas está deshabilitado).
# Ejemplo con Gmail: activa 2FA y crea una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords) y úsala en SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tucorreo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion
EMAIL_FROM=tucorreo@gmail.com
# Ejemplo con SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587,
#   SMTP_USER=apikey, SMTP_PASS=<tu_clave_de_api_de_SendGrid>, EMAIL_FROM=...
